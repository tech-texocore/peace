# Peace config template (backend + web).
#   Local:      .env.development   (npm run dev)
#   Production: .env.production    (NODE_ENV=production — PM2, next build)
# Lines marked "VPS:" show the production value — see docs/SETUP.md
# Payment, courier and messaging keys are NOT here — set them in admin → Integrations.

# ─── URLs ───────────────────────────────────────────────────────────────
# VPS: https://example.com
WEB_URL=http://localhost:3000
# VPS: https://api.example.com
API_URL=http://localhost:4000
API_PREFIX=api
API_PORT=4000
# VPS: production
NODE_ENV=development

# ─── Store ──────────────────────────────────────────────────────────────
STORE_SLUG=peace
STORE_NAME=Peace

# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peace?schema=public

# ─── Secrets (openssl rand -hex 32) ─────────────────────────────────────
# ENCRYPTION_KEY protects the integration keys saved in the database — never change it after go-live
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
SETUP_SECRET=change-me-setup-secret
ENCRYPTION_KEY=replace-with-64-hex-chars

# ─── Firebase ───────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
# Service account (Project settings → Service accounts)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
# Web app (Project settings → Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Media (images / videos) ────────────────────────────────────────────
# local = server disk (VPS). s3 = any S3-compatible bucket: AWS S3, Cloudflare R2, MinIO.
# Switching later: copy the files as-is (same folder layout), change these, restart.
# The database stores only keys, so no data changes are needed.
MEDIA_DRIVER=local
# VPS: /var/www/peace/uploads
MEDIA_DIR=uploads
# Base for image links. Empty = API_URL/uploads (local) or the AWS bucket URL (s3).
# Set it for a CDN, or for R2/MinIO (their public bucket URL).
MEDIA_PUBLIC_URL=
# Only for MEDIA_DRIVER=s3 (S3_ENDPOINT only for R2/MinIO; empty for AWS)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# ─── Limits ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
