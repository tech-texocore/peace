# ─── App ────────────────────────────────────────────────────────────────
APP_NAME=peace-backend
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated allow-list; use * for all (dev only)
CORS_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peace?schema=public

# ─── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# One-time secret used only to bootstrap the first Super Admin — see docs/DEVELOPMENT.md
SETUP_SECRET=change-me-setup-secret

# Firebase Admin (from the service account JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Wrap the private key in quotes and keep the literal \n sequences
FIREBASE_PRIVATE_KEY=""

# ─── Rate limiting ──────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Media storage ──────────────────────────────────────────────────────
# 'local' saves to disk (dev). Switch to 's3' and fill the AWS_* keys to
# store uploads (product images/videos, logos) in S3 — no code change needed.
MEDIA_PROVIDER=local
# Public base for building asset URLs (local: the API; s3: your CDN/S3 domain)
MEDIA_PUBLIC_URL=http://localhost:4000
MEDIA_LOCAL_DIR=uploads
# Fill these when MEDIA_PROVIDER=s3
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CloudFront/CDN base; falls back to the S3 URL
AWS_S3_CDN_URL=

# ─── Notifications ──────────────────────────────────────────────────────
# 'console' (dev) logs messages to the server — no keys needed. Switch a
# channel to its live provider only after adding its keys below.
# See docs/CLIENT_INTEGRATIONS.md.
EMAIL_PROVIDER=console
EMAIL_FROM=Peace <no-reply@peace.local>
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
PUSH_PROVIDER=console

# ─── Integrations (fill when the client provisions — docs/CLIENT_INTEGRATIONS.md) ──
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

COURIER_PROVIDER=bharatship
BHARATSHIP_EMAIL=
BHARATSHIP_PASSWORD=
BHARATSHIP_API_BASE=https://app.bharatship.com
# Pickup warehouse id from BharatShip (create-warehouse / warehouse-list)
BHARATSHIP_PICKUP_ADDRESS_ID=
# Optional: preferred courier code + default parcel weight in grams
BHARATSHIP_COURIER_CODE=
BHARATSHIP_DEFAULT_WEIGHT_GRAMS=500
